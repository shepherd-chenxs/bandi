# 班底控制面 —— Linux 部署单元（2026-10-15）
#
# 装法（细节见 README.md）：
#   sudo cp deploy/bandi.service /etc/systemd/system/bandi.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bandi
#   journalctl -u bandi -f
#
# 前置：Node 22+（服务端用 `node:sqlite`）。**零依赖** —— 不需要 npm install。

[Unit]
Description=bandi 控制面
Documentation=https://gitee.com/cm9531/bandi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bandi
Group=bandi
WorkingDirectory=/opt/bandi

# 数据落点**必须显式指**：
# 默认是 `<仓库>/data`，而仓库在 /opt/bandi —— 升级（重拉代码 / 覆盖目录）会把库和账本
# 一起冲掉，而且服务用户也未必写得进去。参见 docs/形态决策.md §十二 第 1 条。
Environment=BANDI_DATA=/var/lib/bandi
Environment=BANDI_PORT=8787
# 部署即装：服务起来那一刻把 `bandi` 装进 bandi 用户的 ~/.local/bin（幂等）。
# BANDI_DATA 显式指定时自动安装默认闸住（那是测试/沙箱的口径）—— 真部署在这里明说放行。
Environment=BANDI_INSTALL_CLI=1

# 有人在看管这个进程（2026-11-04）：界面「安全 → 监听地址」改完要重启控制面，
# 服务端靠这个标记才敢自己退出 —— systemd 的 Restart=always 会把它拉起来。
Environment=BANDI_SUPERVISED=1

# 监听地址**不在这个文件里写死**（2026-11-04 用户定）：
#   真源是数据目录的 `config.json`（`listenHost`）—— 界面上能改、改完重启生效，
#   **升级/重装都不会被覆盖**（install.sh 每次都会重新生成本文件）。
#   缺省 `0.0.0.0`：对外服务 + 强制鉴权；让不让进由「总机/分机」和「手机连接」管。
#   ⚠️ 别把地址写回这里 —— 2026-11-04 的实际事故就是三次升级把 0.0.0.0 写回 127.0.0.1，
#   局域网访问全断。要临时钉（调试），用 `BANDI_HOST=127.0.0.1` 启动，或 `bandi reset-host` 救回来。
# 外网/反代还要配 BANDI_ORIGINS=<访问来源>，否则远端浏览器能看不能动（写请求全 403）。

# ⚠️ ExecStart 里的 node 路径要按机器改：先 `which node`。
#    这里写 /usr/bin/node 是 NodeSource 的装法；用 nvm 装的会是 ~/.nvm/... 下的绝对路径
#    （**必须绝对路径** —— systemd 不读你 shell 的 PATH）。
ExecStart=/usr/bin/node /opt/bandi/apps/server/src/server.mjs

Restart=always
RestartSec=3
# 日志走 journald：`journalctl -u bandi -f`
StandardOutput=journal
StandardError=journal

# KillMode 用默认值（control-group）：退出时把整个 cgroup 一起收掉。
# 控制面会 spawn agent CLI 子进程 —— 只杀主进程会把它们变成孤儿，
# 继续花额度、继续改文件。（这一条在服务端兼执行端时才是要害。）
TimeoutStopSec=20

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
