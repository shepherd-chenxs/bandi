{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班底",
  "version": "1.5.0",
  "identifier": "app.local.bandi.mobile",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 牧羊人",
    "publisher": "牧羊人",
    "category": "Utility",
    "shortDescription": "班底手机端",
    "longDescription": "把局域网上的班底控制面装进手机：配对、看板、审卡、对话。界面复用 apps/web，壳只负责地址发现与连接。"
  }
}
