<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 扫一扫（2026-11）：相机走 WebView 的 getUserMedia，wry 的
         RustWebChromeClient.onPermissionRequest 会替我们请求这条运行时权限。
         但权限必须先在 manifest 里声明 —— 没声明的话系统直接拒绝，
         getUserMedia 报 NotAllowedError（表现为"相机权限被拒绝"，看着像没授权）。
         ⚠️ 这是 gen/android 里的手改，重新 `tauri android init` 后要再加一次。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      锁竖屏（2026-11-03 用户："手机端锁定竖屏"）。

      壳只做手机形态：界面全是单列（列表 / 详情 / 底部四 tab），横过来只会把列表压成
      两行高、把键盘顶到一半。所以方向在这层钉死，不去 CSS 里补救（Web 侧补救不了：
      `screen.orientation.lock()` 要先进全屏，浏览器里调不动）。

      · 对 Android：`screenOrientation` 是 Activity 的硬约束，连系统"自动旋转"开关都
        翻不动它；
      · 对 PWA（浏览器"添加到主屏幕"）：靠 manifest 的 `orientation: portrait-primary`，
        见 apps/web/manifest.webmanifest（那份文件才是那条路的方向来源）。

      ⚠️ 同样是 gen/android 里的手改，重新 init 后要再加一次（build-android.mjs 打包前会扫）。
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.bandi_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
