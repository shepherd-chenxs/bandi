<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 扫一扫（2026-11）：相机走 WebView 的 getUserMedia，wry 的
         RustWebChromeClient.onPermissionRequest 会替我们请求这条运行时权限。
         但权限必须先在 manifest 里声明 —— 没声明的话系统直接拒绝，
         getUserMedia 报 NotAllowedError（表现为"相机权限被拒绝"，看着像没授权）。
         ⚠️ 这是 gen/android 里的手改，重新 `tauri android init` 后要再加一次。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 语音输入（2026-11）：系统 SpeechRecognizer 要录音权限。运行时授权由
         SpeechPlugin 自己 requestPermissions，这条只是"允许申请"。
         ⚠️ 同样是 gen/android 里的手改，重新 init 后要再加一次。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 的包可见性：不声明 queries，SpeechRecognizer.isRecognitionAvailable()
         会恒返回 false（看不到任何识别服务），表现成"这台手机没有语音引擎"。
         ⚠️ 手改，重新 init 后要再加一次。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.bandi_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
