{
  "id": "ssh",
  "label": "远程连接",
  "version": "0.3.1",
  "description": "登记 SSH 服务器、生成与核对密钥、测连通性。登记表就是 ~/.bandi/servers.yaml —— 数字员工带的内置 SSH 工具读的也是它。",
  "category": "运维",
  "panel": {
    "slot": "settings.section",
    "mode": "declarative",
    "blocks": [
      {
        "type": "form",
        "formId": "server",
        "heading": "登记一台机器",
        "fields": [
          {
            "key": "alias",
            "label": "别名",
            "required": true,
            "hint": "唯一标识，例如 bandi-hs4g。改这一项等于新建一台。"
          },
          {
            "key": "host",
            "label": "地址",
            "required": true,
            "hint": "IPv4 或域名，不要带端口和路径。"
          },
          {
            "key": "user",
            "label": "登录用户",
            "required": true
          },
          {
            "key": "port",
            "label": "端口",
            "value": "22"
          },
          {
            "key": "key_path",
            "label": "私钥路径",
            "hint": "留空则用 ~/.ssh/<别名>。"
          },
          {
            "key": "purpose",
            "label": "备注",
            "type": "textarea"
          },
          {
            "key": "gen_key",
            "label": "生成密钥对",
            "type": "checkbox",
            "value": true,
            "hint": "保存后在本机生成一对 ed25519 密钥（私钥 ~/.ssh/<别名>，公钥同名 .pub）。已有同名文件会拒绝生成，绝不覆盖。",
            "clientOnly": true,
            "followUp": {
              "method": "POST",
              "api": "/api/ssh/servers/{alias}/key"
            }
          }
        ],
        "submit": {
          "method": "POST",
          "api": "/api/ssh/servers",
          "label": "保存"
        },
        "layout": "side-label"
      }
    ],
    "split": {
      "master": {
        "heading": "登记表",
        "keyField": "alias",
        "source": {
          "api": "/api/ssh/servers",
          "pick": "servers"
        },
        "title": "{alias}",
        "subtitle": "{user}@{host}:{port}",
        "add": {
          "label": "＋ 添加",
          "form": "server"
        },
        "empty": "一台都没登记"
      },
      "guide": {
        "label": "引导",
        "title": "把公钥装到服务器 · {alias}",
        "blocks": [
          {
            "type": "code",
            "heading": "公钥",
            "copyLabel": "复制公钥",
            "source": {
              "api": "/api/ssh/servers/{alias}/key",
              "pick": "public_key"
            },
            "hint": "{message}",
            "emptyAction": {
              "label": "生成密钥对",
              "method": "POST",
              "api": "/api/ssh/servers/{alias}/key",
              "confirm": "为「{alias}」生成一对 ed25519 密钥？\n\n私钥写到 ~/.ssh/{alias}，公钥写到同名 .pub。\n已有同名文件时会拒绝生成，绝不覆盖。"
            }
          },
          {
            "type": "steps",
            "heading": "把公钥装到服务器",
            "source": {
              "api": "/api/ssh/servers/{alias}/key",
              "pick": "guide_steps"
            },
            "empty": "这台机器还没生成密钥，先生成再按步骤装。"
          }
        ]
      },
      "rowActions": [
        {
          "type": "button",
          "label": "测",
          "title": "测试连通性（顺带核对服务器上的公钥指纹）",
          "resultTitle": "连通性 · {alias}",
          "primary": true,
          "action": {
            "method": "POST",
            "api": "/api/ssh/servers/{alias}/test"
          },
          "resultField": "detail"
        },
        {
          "type": "button",
          "label": "改",
          "title": "编辑这台机器的登记信息",
          "edit": "server"
        },
        {
          "type": "button",
          "label": "删",
          "title": "从登记表删掉这台机器（只删这一行，服务器和密钥文件都不动）",
          "action": {
            "method": "DELETE",
            "api": "/api/ssh/servers/{alias}"
          },
          "confirm": "从登记表删掉「{alias}」？\n\n只删这一行，服务器和密钥文件都不动。"
        }
      ]
    }
  },
  "permissions": [
    "GET:/api/ssh/servers",
    "POST:/api/ssh/servers",
    "DELETE:/api/ssh/servers/{alias}",
    "GET:/api/ssh/servers/{alias}/key",
    "POST:/api/ssh/servers/{alias}/key",
    "POST:/api/ssh/servers/{alias}/test"
  ]
}
