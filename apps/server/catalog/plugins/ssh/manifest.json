{
  "id": "ssh",
  "label": "远程连接",
  "version": "0.6.2",
  "description": "登记 SSH 服务器、生成与核对密钥、测连通性。登记表就是 ~/.bandi/servers.yaml —— 数字员工带的内置 SSH 工具读的也是它。",
  "category": "运维",
  "panel": {
    "slot": "settings.section",
    "mode": "declarative",
    "blocks": [
      {
        "type": "form",
        "formId": "server",
        "heading": "新建连接",
        "fields": [
          {
            "key": "alias",
            "label": "连接名",
            "required": true,
            "defaultFrom": "host",
            "hint": "唯一标识，例如 bandi-hs4g；留空则直接用主机地址。改这一项等于新建一台。"
          },
          {
            "key": "host",
            "label": "主机",
            "required": true,
            "half": true,
            "placeholder": "输入主机地址或 IP，例如 192.168.1.100"
          },
          {
            "key": "port",
            "label": "端口",
            "half": "sm",
            "value": "22"
          },
          {
            "key": "user",
            "label": "用户名",
            "required": true,
            "placeholder": "输入用户名，例如 root"
          },
          {
            "key": "auth_type",
            "label": "认证方式",
            "type": "segment",
            "value": "key",
            "options": [
              { "value": "key", "label": "私钥" },
              { "value": "password", "label": "密码" }
            ]
          },
          {
            "key": "password",
            "label": "密码",
            "type": "password",
            "showIf": { "field": "auth_type", "equals": "password" },
            "placeholder": "输入 SSH 密码",
            "hint": "只落本机 ~/.bandi/ssh-secrets.json（登记表里不存，界面也不回显）；编辑时留空 = 沿用已存的密码。"
          },
          {
            "key": "key_path",
            "label": "私钥路径",
            "pick": "file",
            "showIf": { "field": "auth_type", "equals": "key" },
            "hint": "留空则用 ~/.ssh/<连接名>；还没有钥匙就先登记，到详情里生成。"
          },
          {
            "key": "purpose",
            "label": "备注",
            "type": "textarea"
          }
        ],
        "submit": {
          "method": "POST",
          "api": "/api/ssh/servers",
          "label": "添加并连接",
          "follow": {
            "method": "POST",
            "api": "/api/ssh/servers/{alias}/test",
            "ok": "「{alias}」已保存，连接正常。",
            "fail": "「{alias}」已保存，但连接没通（详情里点「测」看完整原因）"
          }
        }
      }
    ],
    "split": {
      "master": {
        "heading": "登记表",
        "keyField": "alias",
        "source": {
          "api": "/api/ssh/servers",
          "pick": "servers"
        },
        "title": "{alias}",
        "subtitle": "{user}@{host}:{port}",
        "add": {
          "label": "＋ 添加",
          "form": "server"
        },
        "empty": "一台都没登记"
      },
      "detail": {
        "title": "{alias}",
        "subtitle": "{user}@{host}:{port}",
        "empty": "左边选一台机器",
        "actions": [
          {
            "type": "button",
            "label": "测",
            "title": "测试连通性（顺带核对服务器上的公钥指纹）",
            "resultTitle": "连通性 · {alias}",
            "primary": true,
            "action": {
              "method": "POST",
              "api": "/api/ssh/servers/{alias}/test"
            },
            "resultField": "detail"
          },
          {
            "type": "button",
            "label": "改",
            "title": "编辑这台机器的登记信息",
            "edit": "server"
          },
          {
            "type": "button",
            "label": "删",
            "title": "从登记表删掉这台机器（只删这一行，服务器和密钥文件都不动）",
            "action": {
              "method": "DELETE",
              "api": "/api/ssh/servers/{alias}"
            },
            "confirm": "从登记表删掉「{alias}」？\n\n只删这一行，服务器和密钥文件都不动。"
          }
        ],
        "blocks": [
          {
            "type": "tabs",
            "tabs": [
              {
                "label": "连接信息",
                "blocks": [
                  {
                    "type": "keyvalue",
                    "rows": [
                      {
                        "label": "地址",
                        "value": "{host}"
                      },
                      {
                        "label": "端口",
                        "value": "{port}"
                      },
                      {
                        "label": "认证方式",
                        "value": "{auth_label}"
                      },
                      {
                        "label": "登录用户",
                        "value": "{user}"
                      },
                      {
                        "label": "密钥",
                        "value": "{key_state}"
                      },
                      {
                        "label": "私钥路径",
                        "value": "{key_path}"
                      },
                      {
                        "label": "备注",
                        "value": "{purpose}"
                      }
                    ]
                  },
                  {
                    "type": "code",
                    "heading": "密钥",
                    "onlyWhenEmpty": true,
                    "source": {
                      "api": "/api/ssh/servers/{alias}/key",
                      "pick": "public_key"
                    },
                    "hint": "这台还没生成密钥。点右上角「生成密钥对」生成一对 ed25519；生成后到「引导」页签照步骤把公钥装到服务器上。",
                    "emptyAction": {
                      "label": "生成密钥对",
                      "method": "POST",
                      "api": "/api/ssh/servers/{alias}/key",
                      "confirm": "为「{alias}」生成一对 ed25519 密钥？\n\n私钥写到 ~/.ssh/{alias}，公钥写到同名 .pub。\n已有同名文件时会拒绝生成，绝不覆盖。"
                    }
                  }
                ]
              },
              {
                "label": "引导",
                "blocks": [
                  {
                    "type": "steps",
                    "heading": "把公钥装到服务器",
                    "source": {
                      "api": "/api/ssh/servers/{alias}/key",
                      "pick": "guide_steps"
                    },
                    "empty": "这台机器还没生成密钥，先生成再按步骤装。",
                    "emptyAction": {
                      "label": "生成密钥对",
                      "method": "POST",
                      "api": "/api/ssh/servers/{alias}/key",
                      "confirm": "为「{alias}」生成一对 ed25519 密钥？\n\n私钥写到 ~/.ssh/{alias}，公钥写到同名 .pub。\n已有同名文件时会拒绝生成，绝不覆盖。"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "permissions": [
    "GET:/api/ssh/servers",
    "POST:/api/ssh/servers",
    "DELETE:/api/ssh/servers/{alias}",
    "GET:/api/ssh/servers/{alias}/key",
    "POST:/api/ssh/servers/{alias}/key",
    "POST:/api/ssh/servers/{alias}/test"
  ]
}
