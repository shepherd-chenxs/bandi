{
  "id": "project-panel",
  "label": "研发面板",
  "version": "0.2.0",
  "description": "软件研发项目专属：把所有项目的进度、发布与负责人汇到一屏概览——几个项目、各自进度到哪、谁负责、最近动了什么。只读，不改任何项目文件。（项目档案与任务看板都不在这儿——那是平台「项目」页的一等功能。）",
  "category": "研发",
  "panel": {
    "slot": "plugins",
    "mode": "declarative",
    "blocks": [
      {
        "type": "text",
        "text": "纳入面板的这些项目，进度、发布与负责人一眼看全；点进某个项目再看版本明细。只读看板，不改任何项目文件。"
      },
      {
        "type": "stats",
        "source": { "api": "/api/status/projects", "pick": "projects" },
        "items": [
          {
            "label": "已纳入面板",
            "value": "{all}",
            "unit": "个",
            "foot": "从「项目」账本里挑的",
            "calc": { "all": "count" }
          },
          {
            "label": "有进度文件",
            "value": "{managed}",
            "unit": "个",
            "foot": "能读到 .bandi/status.yaml",
            "tone": "ok",
            "calc": { "managed": { "countIf": "ok" } }
          },
          {
            "label": "缺进度文件",
            "value": "{pending}",
            "unit": "个",
            "foot": "该去补一份，见右侧",
            "tone": "warn",
            "calc": { "pending": { "countIf": { "field": "ok", "is": false } } }
          },
          {
            "label": "已发布版本",
            "value": "{released}",
            "unit": "个",
            "foot": "只算有进度文件的项目",
            "tone": "accent",
            "calc": { "released": { "sumIf": { "field": "released_count", "where": "ok" } } }
          }
        ]
      },
      {
        "type": "cards",
        "heading": "项目进度",
        "subheading": "有进度文件 {shown_count} 个 · 点卡进详情",
        "source": { "api": "/api/status/projects", "pick": "projects", "filter": { "field": "ok", "is": true } },
        "columns": 3,
        "manage": {
          "label": "选择项目",
          "title": "选择要纳入面板的项目",
          "hint": "只勾你真正在跟的项目。没勾的不会出现在面板上，也不会被当成「待处理」。列表来自「项目」账本里已登记的全部项目。",
          "source": { "api": "/api/status/ledger", "pick": "projects" },
          "keyField": "id",
          "flagField": "panel_managed",
          "titleField": "name",
          "subtitleField": "status_text",
          "noteField": "root",
          "save": { "api": "/api/status/managed", "field": "ids" },
          "empty": "「项目」账本里还没有项目 —— 先去「项目」页登记一个"
        },
        "card": {
          "title": "{name}",
          "subtitle": "{summary_text}",
          "badge": "{status_text}",
          "badgeTone": "ok",
          "members": "{pm_name} · 起于 {started_text}",
          "lines": [
            { "label": "版本", "value": "{version_count} 个 · 已发布 {released_count} 个" }
          ],
          "foot": [
            {
              "label": "最新发布",
              "value": "{latest_released_version} · {latest_released_path}",
              "fallback": "还没有已发布的版本"
            }
          ],
          "href": "#/project/{id}"
        },
        "empty": "还没有纳入的项目 —— 点「选择项目」从「项目」账本里挑几个进来；挑进来的项目要有 .bandi/status.yaml 才显示进度"
      },
      {
        "type": "cards",
        "aside": true,
        "heading": "需要处理",
        "subheading": "{shown_count}",
        "source": { "api": "/api/status/projects", "pick": "projects", "filter": { "field": "ok", "is": false } },
        "columns": 1,
        "card": {
          "title": "{name}",
          "subtitle": "{error}",
          "badge": "需处理",
          "badgeTone": "warn",
          "href": "#/project/{id}"
        },
        "empty": "都纳管了，没有待处理的"
      },
      {
        "type": "list",
        "aside": true,
        "heading": "最近动态",
        "source": { "api": "/api/status/projects", "pick": "projects", "sort": { "by": "updated", "dir": "desc" }, "limit": 6 },
        "title": "{name} · {status_text}",
        "subtitle": "{updated}",
        "empty": "还没有更新记录"
      }
    ]
  },
  "permissions": ["GET:/api/status/projects", "GET:/api/status/ledger", "POST:/api/status/managed"]
}
